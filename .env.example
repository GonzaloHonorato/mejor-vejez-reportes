# Copiar a `.env` (NO se versiona). En Dokploy van en la pestaña Environment: estos valores
# son los nombres del servicio en la red docker de Dokploy (`dokploy-network`). En local, se
# usan los valores por omisión de application.properties (http://localhost:8080 / 8081): para
# desarrollar localmente no copiar este archivo, o sobrescribir estas dos variables.

# URL interna del servicio core.
CORE_URL=http://mejor-vejez-api:8080
# Clave compartida entre los microservicios: la MISMA en core, alertas y reportes.
# Generar una larga y aleatoria (p. ej. `openssl rand -hex 32`). Nunca versionarla.
CLAVE_SERVICIO=

# URL interna del microservicio de alertas y notificaciones.
ALERTAS_URL=http://mejor-vejez-alertas:8081

# Cron del reporte semanal (America/Santiago). Por omisión: primera corrida a
# las 08:00 y luego cada hora hasta las 20:00 (la reserva de envío evita duplicados).
REPORTES_CRON=0 0 8-20 * * MON

# Apaga la corrida programada del reporte semanal (la ruta manual sigue disponible).
PROCESOS_HABILITADOS=true
